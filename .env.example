# Copy to .env (never commit .env). The OpenAI SDK reads the first two by itself.
OPENAI_API_KEY=PASTE_YOUR_CLASS_KEY_HERE
OPENAI_BASE_URL=PASTE_THE_CLASS_PROXY_URL_HERE

LLM_MODEL=gemma-4-E4B-it
LLM_TEMPERATURE=0

# agent tool-calling style: auto (try native function calling, fall back to JSON actions) | native | json
AGENT_MODE=auto
MAX_STEPS=6
TOP_K=5

# retrieval: hybrid (BM25 + dense, RRF) | dense | bm25.  Dense needs sentence-transformers.
RETRIEVAL=hybrid
# Relevance floor. 0 = off. Pick it from eval/results/threshold_sweep.json (see README).
MIN_SCORE=0
